# Safe public template. Do not put interface, PCI, MAC, PHC, credentials, or
# other machine-discovered values in this file.
# Run `sudo ./ptpctl`; the wizard creates the ignored configs/site.env after
# validating the experiment/network owner's answers.

# NTP and slave system-clock ownership are site choices. NTP_SERVERS accepts
# one or more hostnames/IPs separated by spaces or commas; no public default is
# invented.
NTP_ENABLED=TODO
NTP_SERVERS=
PTP_SLAVE_SYSTEM_CLOCK=TODO

# Common values supplied by the experiment or network owner.
PTP_DOMAIN=TODO
PTP_TRANSPORT=TODO
PTP_DELAY_MECHANISM=TODO
PTP_PROFILE=TODO
TRANSPORT_SPECIFIC=TODO

# Slave-only. MULTICAST needs no configured GM address. UNICAST_CONFIGURED
# requires reviewed unicast directives in PROFILE_EXTRA_CONFIG.
GRANDMASTER_DISCOVERY=TODO
SLAVE_CLOCK_POLICY=TODO
SLAVE_TAI_UTC_POLICY=TODO

# Master-only. REQUIRE_SYNCED_SYSTEM refuses an unsynchronized CLOCK_REALTIME.
# ALLOW_LAB_FREERUN permits a protocol master with a prominent warning.
MASTER_TIME_POLICY=TODO
# Confirm at deployment time from a current leap-second authority.
MASTER_UTC_OFFSET=TODO
# Record the authority, for example IERS Bulletin C or the site's time owner.
MASTER_UTC_OFFSET_AUTHORITY=TODO

# IEEE1588_DEFAULT uses the bundled conservative templates. Other profiles and
# configured unicast require a reviewed file of global linuxptp directives.
PROFILE_EXTRA_CONFIG=NONE

SYNC_TIMEOUT_SECONDS=120
MASTER_READY_TIMEOUT_SECONDS=30
PHC2SYS_VERIFY_SECONDS=8
NTP_PROBE_TIMEOUT_SECONDS=10
NTP_SYNC_TIMEOUT_SECONDS=60
